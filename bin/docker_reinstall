#!/usr/bin/env bash
cd "$(dirname "$0")/../docker" || exit

# The stack runs on the NAS's own docker daemon, reached over ssh (Host nas in linux_settings' settings/ssh/config)
export DOCKER_HOST=ssh://nas

docker compose build
docker compose up -d --remove-orphans

if [ "$1" == '--hard' ]; then
	docker compose pull
	docker image prune -f
	docker compose restart
fi
